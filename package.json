{
  "name": "ying-tunnel",
  "description": "nodejs bun 内网穿透工具套装",
  "keywords": [
    "内网穿透",
    "tunnel",
    "typescript",
    "nodejs",
    "bun",
    "turbo"
  ],
  "author": {
    "name": "jackying007",
    "email": "yingjack007@gmail.com",
    "url": "https://jackying007.github.io/"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "test/*"
  ],
  "scripts": {
    "dev:apps": "bun --env-file=.env turbo run dev --filter=\"./apps/*\"",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "dev:pkgs": "turbo run dev --filter=\"./packages/*\"",
    "build:pkgs": "turbo run build --filter=\"./packages/*\"",
    "compile:server": "turbo run compile --filter=@ying-tunnel/server",
    "check": "turbo run check",
    "dev:test-server": "turbo run dev --filter=test-server",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.5.13",
    "prettier": "^3.9.6",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
