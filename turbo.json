{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "TUNNEL_SERVER_HOST",
        "TUNNEL_SERVER_PORT",
        "PROXY_SERVER_HOST",
        "PROXY_SERVER_PORT",
        "ADMIN_API_PORT",
        "ADMIN_PASSWORD"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "artifacts/**"]
    },
    "compile": {},
    "lint": {},
    "check": {}
  }
}
